# KorrinOS kernel features
#
# GENERATED to match tinker/Makefile: every CONFIG_TINKER_* symbol the Makefile
# references has an entry here, and vice versa, so the two cannot drift.
#
# This is a FRAGMENT, meant to be sourced from a real kernel tree's top-level
# Kconfig:
#
#     source "drivers/tinker/Kconfig"
#
# with the directory added to that tree's top-level Makefile:
#
#     obj-y += tinker/
#
# Deliberately no "mainmenu" and no wrapping menu: those belong only in a
# top-level Kconfig, and putting them in a sourced file confuses kconfig.
#
# See ../README-KERNEL-STATE.md. The kernel/ tree in this repo is a partial
# snapshot - no include/, arch/, drivers/ or Kconfig - so none of this can be
# built until a real kernel source tree is fetched and `make prepare` has run.

comment "KorrinOS kernel features"

config TINKER
	bool "KorrinOS kernel features"
	help
	  Base menu for the KorrinOS kernel feature modules. These compile into the
	  kernel image (obj-y) rather than as loadable modules, because the point is
	  to be real kernel code and not a service running beside one.

config TINKER_CORE
	bool "KorrinOS core (/proc/tinker interface)"
	depends on TINKER
	help
	  Shared plumbing for the KorrinOS modules: the /proc/tinker entry point,
	  tinker_proc_root, and the helpers the feature modules call into. Every other
	  TINKER_* module needs this, so it is selected automatically.

