#!/bin/busybox sh
# KorrinOS live-boot init for a freshly built kernel.
#
# The shipped ISO pairs its kernel with an initramfs generated for a different
# kernel release, so every modprobe inside that initramfs fails on vermagic and
# udev never populates /dev. The root-device scan then spins forever.
#
# This initramfs needs no modules at all: the kernel has SQUASHFS, BLK_DEV_LOOP,
# ISO9660, DEVTMPFS and EXT4 built in, so it can mount the live media and hand
# off to the real distribution userspace directly.

BB=/bin/busybox
export PATH=/bin

bb() { $BB "$@"; }
mount() { $BB mount "$@"; }
fail() {
	echo "KINIT-FAIL: $*"
	echo "--- /dev ---"
	$BB ls -l /dev 2>/dev/null
	exec $BB sh
}

mount -t proc     proc     /proc  || echo "KINIT: warn proc"
mount -t sysfs    sysfs    /sys   || echo "KINIT: warn sys"
mount -t devtmpfs devtmpfs /dev   || echo "KINIT: warn devtmpfs"

# /dev/sr0 can take a moment to appear on some hosts.
CD=""
i=0
while [ $i -lt 50 ]; do
	if [ -b /dev/sr0 ]; then CD=/dev/sr0; break; fi
	[ -b /dev/sda ] && { CD=/dev/sda; break; }
	$BB sleep 0.2
	i=$((i + 1))
done
[ -n "$CD" ] || fail "no CD-ROM block device appeared"

echo "KINIT: mounting live media from $CD"
mount -t iso9660 -o ro "$CD" /cd || fail "cannot mount $CD as iso9660"

ROOTIMG=""
for cand in /cd/casper/filesystem.squashfs /cd/live/filesystem.squashfs; do
	[ -f "$cand" ] && { ROOTIMG="$cand"; break; }
done
[ -n "$ROOTIMG" ] || fail "no filesystem.squashfs on the media"
echo "KINIT: root image $ROOTIMG ($(stat -c %s "$ROOTIMG") bytes)"

echo "KINIT: loop-mounting root"
mount -o loop,ro "$ROOTIMG" /root || fail "cannot loop-mount $ROOTIMG"

# Hand over to the real distro userspace.
if [ -x /root/sbin/init ]; then
	INIT=/sbin/init
elif [ -x /root/usr/lib/systemd/systemd ]; then
	INIT=/lib/systemd/systemd
else
	fail "no /sbin/init or systemd in the rootfs"
fi

echo "KINIT: switch_root into rootfs, exec $INIT"

# The real userspace expects these to already exist. switch_root carries the
# current mounts across, so everything mounted here must be mounted at the path
# the new root expects - /dev/pts under /dev, /run as its own tmpfs, and so on.
#
# systemd blocks right after "Started Journal Service" and then stops dead if
# /run is not a tmpfs, and it cannot create ptys without devpts.
mkdir -p /root/proc /root/sys /root/dev /root/dev/pts /root/run /root/tmp
mount -t devpts -o gid=5,mode=620 devpts /root/dev/pts 2>/dev/null || echo "KINIT: warn devpts"
mount -t tmpfs tmpfs /root/run                          2>/dev/null || echo "KINIT: warn run"
mount -t tmpfs -o mode=1777,size=10% tmpfs /root/dev/shm   2>/dev/null || echo "KINIT: warn shm"
mount -t tmpfs -o mode=755,size=10%  tmpfs /root/dev/mqueue 2>/dev/null || echo "KINIT: warn mqueue"
chmod 1777 /root/dev/shm 2>/dev/null
ln -sf /proc/self/fd   /root/dev/fd     2>/dev/null
ln -sf /proc/self/fd/0 /root/dev/stdin  2>/dev/null
ln -sf /proc/self/fd/1 /root/dev/stdout 2>/dev/null
ln -sf /proc/self/fd/2 /root/dev/stderr 2>/dev/null

# Deliberately do NOT unmount /cd. The loop device backing /root has /cd as its
# backing store; unmounting /cd while /root is live leaves the real rootfs
# without a readable backing file, and the system wedges the moment systemd
# starts reading from it. It costs one loop mount for the life of the session.
exec $BB switch_root /root "$INIT"