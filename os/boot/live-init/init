#!/bin/busybox sh
# KorrinOS live-boot init.
#
# Mounts the live media, exposes the real distribution userspace, and hands over
# to systemd.
#
# Two things this must get right, both of which cost real debugging time:
#
# 1. No modules. The ISO's own initramfs is generated for a different kernel
#    release, so every modprobe inside it fails on vermagic and udev never
#    populates /dev. This initramfs loads nothing: the kernel has SQUASHFS,
#    BLK_DEV_LOOP, ISO9660, DEVTMPFS and EXT4 built in.
#
# 2. The handed-over root must be WRITABLE. The squashfs is read-only, and a
#    read-only root makes systemd fall over immediately:
#      systemd-logind: code=exited, status=238/STATE_DIRECTORY
#    because it cannot create /var/lib/systemd/linger. snapd and anything else
#    that persists state fails the same way, and the whole boot reports
#    "degraded" with no desktop. So the squashfs becomes the lower layer of an
#    overlay, with a tmpfs upper layer giving a writable root that still costs
#    no space on the medium.
BB=/bin/busybox
export PATH=/bin

bb() { $BB "$@"; }
mount() { $BB mount "$@"; }
fail() {
	echo "KINIT-FAIL: $*"
	echo "--- /dev ---"
	$BB ls -l /dev 2>/dev/null
	exec $BB sh
}

mount -t proc     proc     /proc  || echo "KINIT: warn proc"
mount -t sysfs    sysfs    /sys   || echo "KINIT: warn sys"
mount -t devtmpfs devtmpfs /dev   || echo "KINIT: warn devtmpfs"

# The mount points below are created here rather than only in the initramfs
# builder, so the init works with any initramfs layout. Without these the
# loop mount silently fails with "cannot loop-mount" and drops to a shell.
mkdir -p /low /ovl /newroot /cd

# /dev/sr0 can take a moment to appear on some hosts.
CD=""
i=0
while [ $i -lt 50 ]; do
	if [ -b /dev/sr0 ]; then CD=/dev/sr0; break; fi
	[ -b /dev/sda ] && { CD=/dev/sda; break; }
	$BB sleep 0.2
	i=$((i + 1))
done
[ -n "$CD" ] || fail "no CD-ROM block device appeared"

echo "KINIT: mounting live media from $CD"
mount -t iso9660 -o ro "$CD" /cd || fail "cannot mount $CD as iso9660"

ROOTIMG=""
for cand in /cd/casper/filesystem.squashfs /cd/live/filesystem.squashfs; do
	[ -f "$cand" ] && { ROOTIMG="$cand"; break; }
done
[ -n "$ROOTIMG" ] || fail "no filesystem.squashfs on the media"
echo "KINIT: root image $ROOTIMG ($($BB stat -c %s "$ROOTIMG") bytes)"

# --- build a writable overlay over the read-only squashfs -------------------
# Keep /cd mounted: the loop device uses it as its backing store, and unmounting
# it leaves the lower layer unreadable.
echo "KINIT: loop-mounting root read-only as lower layer"
mount -o loop,ro "$ROOTIMG" /low || fail "cannot loop-mount $ROOTIMG"

# tmpfs holds the overlay upper/work layers, so writes cost RAM, not the medium.
mount -t tmpfs -o size=75%,mode=0755 tmpfs /ovl || fail "cannot mount overlay tmpfs"
mkdir -p /ovl/upper /ovl/work || fail "cannot create overlay dirs"

ROOT=/newroot
mkdir -p "$ROOT" || fail "cannot create $ROOT"
echo "KINIT: overlaying writable upper layer"
if ! mount -t overlay overlay \
	-o "lowerdir=/low,upperdir=/ovl/upper,workdir=/ovl/work" "$ROOT"; then
	# Overlay can be unavailable; a read-only root is worse than none, but a
	# booting shell beats a dead machine, so fall back and say so plainly.
	echo "KINIT: WARN overlayfs unavailable - continuing READ-ONLY"
	echo "KINIT: WARN systemd-logind and snapd will fail without a writable /var"
	ROOT=/low
	mount -o remount,rw "$ROOT" 2>/dev/null || true
fi

if [ -x "$ROOT/sbin/init" ]; then
	INIT=/sbin/init
elif [ -x "$ROOT/usr/lib/systemd/systemd" ]; then
	INIT=/lib/systemd/systemd
else
	fail "no /sbin/init or systemd in the rootfs"
fi

echo "KINIT: switch_root into $ROOT, exec $INIT"

# The real userspace expects these already mounted. switch_root carries the
# current mounts across, so each must be mounted at the path the new root wants.
# systemd blocks right after "Started Journal Service" if /run is not a tmpfs,
# and nothing can allocate a pty without devpts.
mkdir -p "$ROOT"/proc "$ROOT"/sys "$ROOT"/dev "$ROOT"/dev/pts "$ROOT"/run "$ROOT"/tmp
mount -t devpts -o gid=5,mode=620 devpts "$ROOT/dev/pts" 2>/dev/null || echo "KINIT: warn devpts"
mount -t tmpfs tmpfs "$ROOT/run"                          2>/dev/null || echo "KINIT: warn run"
mount -t tmpfs -o mode=1777,size=25% tmpfs "$ROOT/dev/shm"  2>/dev/null || echo "KINIT: warn shm"
mount -t tmpfs -o mode=755,size=5%  tmpfs "$ROOT/dev/mqueue" 2>/dev/null || echo "KINIT: warn mqueue"
chmod 1777 "$ROOT/dev/shm" 2>/dev/null
ln -sf /proc/self/fd    "$ROOT/dev/fd"     2>/dev/null
ln -sf /proc/self/fd/0  "$ROOT/dev/stdin"  2>/dev/null
ln -sf /proc/self/fd/1  "$ROOT/dev/stdout" 2>/dev/null
ln -sf /proc/self/fd/2  "$ROOT/dev/stderr" 2>/dev/null

exec $BB switch_root "$ROOT" "$INIT"