#!/bin/bash
# kcommand launcher — the opt-in entry point to the KorrinOS terminal.
#
# Installed under two names:
#   kcommand  the plain command
#   @k        a short prefix, so a kcommand session is one keystroke away
#
# Why not "!": in bash, "!" is the reserved pipeline-negation word, not a
# command. Typing "! kcommand" still RUNS kcommand and merely inverts its exit
# status, so the syntax works perfectly well as a launcher - the only visible
# side effect is a flipped $?. We compensate for that below, which makes
# "! kcommand" behave exactly as typed.
#
# "@k" is also installed as a conventional prefix for anyone who prefers a
# prefix that does not involve exit-code gymnastics. Set KCOMMAND_PREFIX to
# choose another one.

set -uo pipefail

KC_BIN="${KCOMMAND_BIN:-/usr/bin/kcommand}"

# When set, the exit status is inverted before returning. The launcher enables
# this by default so that "! kcommand ..." reports the wrapped command's real
# status despite bash negating it. Set KCOMMAND_NO_INVERT=1 for direct use
# where no negation is happening.
KC_INVERT="${KCOMMAND_NO_INVERT:+0}"
KC_INVERT="${KC_INVERT:-1}"

kc_finish() {  # kc_finish <status>
    local rc="$1"
    if [ "$KC_INVERT" = "1" ]; then
        # Only a 0/1 code survives a shell's "!" negation meaningfully.
        if [ "$rc" -eq 0 ]; then return 1; fi
        return 0
    fi
    return "$rc"
}

# ---------------------------------------------------------------------------
# Language switching: kcommand!Hindi, kcommand!हिन्दी, kcommand!hi
# ---------------------------------------------------------------------------

# Where the language registry lives. KCOMMAND_REGISTRY overrides the search,
# which keeps this testable from a build tree and lets a developer point at a
# registry that is not the installed one.
KC_REGISTRY="${KCOMMAND_REGISTRY:-}"
if [ -z "$KC_REGISTRY" ]; then
    for cand in \
        /usr/share/korrinos/i18n/languages.tsv \
        "$(dirname "$0")/../i18n/languages.tsv" \
        "$(dirname "$0")/../../i18n/languages.tsv"
    do
        if [ -r "$cand" ]; then KC_REGISTRY="$cand"; break; fi
    done
fi

# kc_list_languages: print "code<TAB>English (endonym)" for every shipped locale.
kc_list_languages() {
    [ -n "$KC_REGISTRY" ] || return 1
    grep -vE '^[[:space:]]*(#|$)' "$KC_REGISTRY" \
        | awk -F'\t' 'NF>=7 && $1!="code" { printf "  %-8s %s (%s)\n", $1, $4, $3 }'
}

# kc_resolve <name>: resolve a language name to "<code> <locale>".
# Matches the English name, the endonym (native name) or the code, so
# "Hindi", "हिन्दी" and "hi" all land on the same locale.
kc_resolve() {
    local want="${1,,}"
    want="${want#\!}"                       # strip the "!" marker
    want="${want#-}"                        # tolerate a leading dash: !-Hindi
    [ -n "$want" ] || return 1
    [ -n "$KC_REGISTRY" ] || return 1
    awk -F'\t' -v want="$want" '
        NF>=7 && $1!="code" {
            key=tolower($4); end=tolower($3); code=tolower($1)
            bare=code; sub(/-.*/, "", bare)
            if (key==want || end==want || code==want || bare==want) {
                print $1 "\t" $2; found=1; exit
            }
        }
        END { exit(found ? 0 : 1) }
    ' "$KC_REGISTRY"
}

# Set LANGUAGE/LANG from a resolved "<code> <locale>" pair.
kc_apply_language() {
    export LANGUAGE="$1"
    export LANG="$2"
}

# Did the first argument ask for a language switch? Sets KC_LANG_CODE/KC_LANG_LOC.
KC_LANG_CODE=""
KC_LANG_LOC=""
kc_take_language() {
    local spec="$1" resolved
    # A bare "!" is the pre-existing no-argument form, not a language.
    [ "$spec" != "!" ] || return 1
    resolved="$(kc_resolve "$spec")" || return 1
    KC_LANG_CODE="${resolved%%	*}"
    KC_LANG_LOC="${resolved##*	}"
    return 0
}

# Informational probes. These exist so the shell can ask about a language
# WITHOUT launching a terminal, which is what lets kcommand!Hindi be rewritten
# by command_not_found_handle instead of needing a file per language.
case "${1:-}" in
    --is-language)
        # Exit 0 when $2 names a shipped locale, 1 otherwise.
        [ "$#" -ge 2 ] || exit 1
        kc_resolve "$2" >/dev/null 2>&1 && exit 0
        exit 1
        ;;
    --languages)
        kc_list_languages
        exit 0
        ;;
esac

# Deliberately NO fallback to a source/build directory.
#
# An earlier version walked up to the build tree and launched the terminal from
# there, which meant a KorrinOS terminal could open on a build machine. The
# build host is not a target device and must never run the OS. The only valid
# location is the installed binary; if it is absent, the launcher says so.
if [ ! -x "$KC_BIN" ]; then
    printf 'kcommand is not installed on this system.\n' >&2
    printf 'Expected: %s\n' "$KC_BIN" >&2
    printf 'It ships with KorrinOS. On a build host it is intentionally absent.\n' >&2
    exit 127
fi

# A leading "!name" switches language. Everything after it is optional.
#
# A leading "!" that is not a bare "!" is ALWAYS meant as a language, so an
# unresolvable one must fail loudly rather than fall through and be handed to
# the shell as a command named "!Klingon".
kc_is_language_spec() {
    case "$1" in
        '!') return 1 ;;
        '!'*) return 0 ;;
    esac
    return 1
}

KC_SWITCHED=0
if [ "$#" -gt 0 ] && kc_is_language_spec "$1"; then
    if kc_take_language "$1"; then
        KC_SWITCHED=1
        shift
        kc_apply_language "$KC_LANG_CODE" "$KC_LANG_LOC"
        if [ "$#" -eq 0 ]; then
            # Switching and opening: play the transition, then hand over.
            exec "$KC_BIN" --language-transition
        fi
    else
        printf 'kcommand: unknown language %s\n\n' "${1#!}" >&2
        printf 'Available languages:\n' >&2
        kc_list_languages >&2 || printf '  (no language registry found)\n' >&2
        exit 2
    fi
elif [ "$#" -eq 1 ] && [ "$1" = "!" ]; then
    # A bare "!" carries no language and no command: just open a terminal.
    # Without this it would be handed to the shell as a command named "!".
    exec "$KC_BIN"
fi

# No arguments: open a terminal. exec replaces this process, so the exit code
# of the terminal itself is what the parent shell sees, negated by "!".
if [ "$#" -eq 0 ]; then
    exec "$KC_BIN"
fi

# Arguments are either kcommand's own flags, or a command to run inside it.
case "$1" in
    -*)
        exec "$KC_BIN" "$@"
        ;;
esac

if command -v "$1" >/dev/null 2>&1; then
    "$KC_BIN" -e "$@"
    kc_finish $?
    exit $?
fi

# Not a known command and not a flag: hand it to kcommand and let it decide,
# which surfaces a proper error rather than silently opening an empty window.
"$KC_BIN" -e "$SHELL" -lc "exec $*"
rc=$?
kc_finish "$rc"
exit $?
