#!/bin/bash
# Generate the `kcommand!<language>` wrapper executables.
#
# Why this file exists
# --------------------
# "kcommand!Hindi" typed with no space is a SINGLE WORD to bash. bash resolves
# a word by name, so it looks for an executable literally called
# "kcommand!Hindi" and never consults a function named "kcommand". Verified:
#
#     $ kcommand() { echo caught; }; kcommand!Hindi
#     bash: kcommand!Hindi: command not found
#
# So the one-word form only works if a real file with that name exists. That is
# what this script emits, one tiny wrapper per language, so the syntax feels
# exactly like a single keystroke decision.
#
# The spaced form `kcommand !Hindi` needs no wrappers and remains the robust
# one: it works for every language, including names containing spaces, which can
# never be a filename.
#
# Usage: kcommand-lang-wrappers <registry.tsv> <target-dir>

set -uo pipefail

REGISTRY="${1:?usage: kcommand-lang-wrappers <registry.tsv> <target-dir>}"
TARGET="${2:?usage: kcommand-lang-wrappers <registry.tsv> <target-dir>}"
LAUNCHER="${KCOMMAND_LAUNCHER:-/usr/bin/kcommand}"

[ -r "$REGISTRY" ] || { printf 'no registry at %s\n' "$REGISTRY" >&2; exit 1; }
mkdir -p "$TARGET" || exit 1

# A wrapper name is only safe as a filename if it has no whitespace, no slash,
# and does not start with a dot. Anything else is reachable via the spaced form.
kc_safe_name() {
    case "$1" in
        ""|.*|*/*|*[[:space:]]*) return 1 ;;
    esac
    printf '%s' "$1"
}

emit() {  # emit <suffix> <language-spec>
    local suffix spec
    suffix="$(kc_safe_name "$1")" || return 0
    spec="$(kc_safe_name "$2")" || return 0
    local path="$TARGET/kcommand!$suffix"
    cat > "$path" <<WRAP || return 1
#!/bin/sh
# Generated by kcommand-lang-wrappers. Opens kcommand in $spec.
exec "$LAUNCHER" '!$spec' "\$@"
WRAP
    chmod 755 "$path"
    EMITTED=$((EMITTED + 1))
}

EMITTED=0
count=0
while IFS=$'\t' read -r code locale endonym english dir script fontpkg rest; do
    [ -n "${code:-}" ] || continue
    case "$code" in \#*|code) continue ;; esac
    [ -n "${english:-}" ] || continue
    count=$((count + 1))
    emit "$code"        "$code"        # kcommand!hi   (always available)
    emit "$english"     "$english"     # kcommand!Hindi
    emit "$endonym"     "$endonym"     # kcommand!हिन्दी
done < "$REGISTRY"

printf 'kcommand-lang-wrappers: %d languages, %d wrappers in %s\n' \
    "$count" "$EMITTED" "$TARGET"